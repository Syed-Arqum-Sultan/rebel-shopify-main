{%- doc -%}
  @param [limit] - {number}
  @param [live_region] - {boolean}

  The maximum number of items in the cart to display. If the number of items in the cart is greater than this limit, the
  count will be displayed as "99+".
{%- enddoc -%}

{%- liquid
  # OPTICA: subtract paired lens add-on items from the displayed count so a
  # frame + Rx lens reads as "1" rather than "2". The cart still has two
  # underlying line items (Shopify requirement for the upcharge variant).
  assign optica_addon_qty = 0
  for ci in cart.items
    for p in ci.properties
      if p.first == 'Linked frame variant' and p.last != blank
        assign optica_addon_qty = optica_addon_qty | plus: ci.quantity
      endif
    endfor
  endfor
  assign optica_display_count = cart.item_count | minus: optica_addon_qty
  if optica_display_count < 0
    assign optica_display_count = 0
  endif
-%}
<div
  ref="cartBubble"
  class="cart-bubble{% if cart == empty %} visually-hidden{% endif %}"
  {% if optica_display_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
    {% if live_region %}
      role="status"
    {% endif %}
  >
    <span class="visually-hidden">
      {{- 'accessibility.cart_count' | t -}}
      : {{ optica_display_count }}
    </span>
    <span
      class="cart-bubble__text-count{% if cart == empty %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or optica_display_count < limit %}
        {{- optica_display_count -}}
      {%- endif -%}
    </span>
  </span>
</div>
